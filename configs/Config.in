menu "Allwinner A333 project"

choice
	prompt "A333 product profile"
	default BR2_A333_PROFILE_DMX

config BR2_A333_PROFILE_DMX
	bool "1280x800 tablet with DMX panel"

config BR2_A333_PROFILE_MEDIA
	bool "1280x800 Bluetooth and network media tablet"

config BR2_A333_PROFILE_HEADLESS
	bool "Headless controller with display pins available as GPIO"

endchoice

config BR2_A333_KERNEL_DEBUG_LOGS
	bool "Verbose kernel boot and BSP debug logs"
	default n
	help
	  Selected by the *-kernel-debug-logs defconfigs. Keeps initcall tracing,
	  early boot console and vendor BSP debug messages. Normal profiles use
	  the quiet kernel fragment and show warnings/errors on the serial console.
	  build.sh synchronizes kernel fragments and U-Boot environment with the
	  selected profile; use a debug profile for verbose diagnostics.

choice
	prompt "Display orientation"
	default BR2_A333_DISPLAY_ORIENTATION_LANDSCAPE_CW
	help
	  Select the physical installation orientation of the native 800x1280
	  MIPI-DSI panel.  The selection is shared by the boot logo, framebuffer
	  applications and touchscreen coordinate mapping.

config BR2_A333_DISPLAY_ORIENTATION_PORTRAIT
	bool "Portrait (0 degrees)"

config BR2_A333_DISPLAY_ORIENTATION_LANDSCAPE_CW
	bool "Landscape, clockwise (90 degrees)"

config BR2_A333_DISPLAY_ORIENTATION_PORTRAIT_INVERTED
	bool "Portrait, inverted (180 degrees)"

config BR2_A333_DISPLAY_ORIENTATION_LANDSCAPE_CCW
	bool "Landscape, counter-clockwise (270 degrees)"

endchoice

config BR2_A333_DISPLAY_ROTATION
	int
	default 0 if BR2_A333_DISPLAY_ORIENTATION_PORTRAIT
	default 90 if BR2_A333_DISPLAY_ORIENTATION_LANDSCAPE_CW
	default 180 if BR2_A333_DISPLAY_ORIENTATION_PORTRAIT_INVERTED
	default 270 if BR2_A333_DISPLAY_ORIENTATION_LANDSCAPE_CCW

source "$BR2_EXTERNAL_A333_PATH/package/dmx-panel/Config.in"
source "$BR2_EXTERNAL_A333_PATH/package/media-panel/Config.in"

endmenu
