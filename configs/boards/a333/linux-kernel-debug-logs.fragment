# Preserve the previous bring-up profile's kernel logging configuration.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_CONSOLE_LOGLEVEL_QUIET=4
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=7
CONFIG_AW_EARLY_PRINTK=y
CONFIG_AW_CCU_DEBUG=y
CONFIG_AW_CCMU_DYNAMIC_DEBUG=y
CONFIG_AW_PINCTRL_DYNAMIC_DEBUG=y
CONFIG_AW_UART_DYNAMIC_DEBUG=y
CONFIG_AW_TIMER_DYNAMIC_DEBUG=y
CONFIG_AW_DUMPREG_DYNAMIC_DEBUG=y
CONFIG_AW_VIDEO_DYNAMIC_DEBUG=y
CONFIG_AW_PWM_DYNAMIC_DEBUG=y
CONFIG_AW_GPADC_DYNAMIC_DEBUG=y
CONFIG_AW_LRADC_DYNAMIC_DEBUG=y
CONFIG_AW_STANDBY_DEBUG=y
CONFIG_USB_SUNXI_USB_DEBUG=y
CONFIG_NTFS_DEBUG=y
CONFIG_IP_ROUTE_VERBOSE=y
