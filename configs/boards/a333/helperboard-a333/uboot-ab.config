# Allwinner-native A/B support.
# SUNXI_SWITCH_SYSTEM selects BOOTCOUNT_LIMIT and BOOTCOUNT_ENV.
CONFIG_SUNXI_SWITCH_SYSTEM=y
CONFIG_SUNXI_ENV_PARTITION="env"
CONFIG_SUNXI_ENV_REDUNDAND_PARTITION="env-redund"

# The vendor GPT loader renames UDISK to LAST_PARTITION_NAME. Keep that tail
# distinct from our explicit userdata partition, otherwise GPT lookup sees
# two userdata entries and must refuse to select/format either one.
CONFIG_LAST_PARTITION_NAME="UDISK"

# This project uses the Allwinner switcher, not Android misc/slot metadata.
# CONFIG_ANDROID_AB is not set
