# Keep printk/dmesg and warnings/errors, but avoid serial debug floods.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=5
CONFIG_CONSOLE_LOGLEVEL_QUIET=5
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=6
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_DYNAMIC_DEBUG_CORE is not set
# CONFIG_AW_EARLY_PRINTK is not set
# CONFIG_AW_LOG_VERBOSE is not set
# CONFIG_AW_CCU_DEBUG is not set
# CONFIG_AW_CCMU_DYNAMIC_DEBUG is not set
# CONFIG_AW_PINCTRL_DYNAMIC_DEBUG is not set
# CONFIG_AW_UART_DYNAMIC_DEBUG is not set
# CONFIG_AW_TIMER_DYNAMIC_DEBUG is not set
# CONFIG_AW_DUMPREG_DYNAMIC_DEBUG is not set
# CONFIG_AW_VIDEO_DYNAMIC_DEBUG is not set
# CONFIG_AW_PWM_DYNAMIC_DEBUG is not set
# CONFIG_AW_GPADC_DYNAMIC_DEBUG is not set
# CONFIG_AW_LRADC_DYNAMIC_DEBUG is not set
# CONFIG_AW_STANDBY_DEBUG is not set
# CONFIG_USB_SUNXI_USB_DEBUG is not set
# CONFIG_NTFS_DEBUG is not set
# CONFIG_IP_ROUTE_VERBOSE is not set
