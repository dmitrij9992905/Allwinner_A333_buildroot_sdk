# The vendor defconfig enables BTF, but the Buildroot kernel fixup requires
# host-pahole for it. Disable BTF for the first bring-up; it can be enabled
# later together with BR2_LINUX_KERNEL_NEEDS_HOST_PAHOLE=y.
# CONFIG_DEBUG_INFO_BTF is not set
# Use FunctionFS through configfs, NOT the legacy g_ffs gadget. Built-in
# g_ffs claims the singleton FunctionFS instance and blocks mkdir ffs.adb.
CONFIG_CONFIGFS_FS=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
# CONFIG_USB_FUNCTIONFS is not set
# The vendor tree contains warnings rejected by the newer Buildroot toolchain.
# Keep them as warnings, matching the original SDK build behaviour.
# CONFIG_WERROR is not set

# The root filesystem is on the internal eMMC and the image has no initramfs.
# These drivers must be available before /sbin/init, otherwise rootwait waits
# forever for /dev/mmcblk0p6 while the kernel appears to have hung.
CONFIG_AW_MMC_HSQ=y
CONFIG_AW_MMC=y
CONFIG_MMC_CQHCI=y
CONFIG_AW_UART_NG=y

# A333 early boot providers required for rootfs on eMMC
CONFIG_AW_CCU=y
CONFIG_AW_SUN65IW1_CCU=y
CONFIG_AW_SUN65IW1_R_CCU=y
CONFIG_AW_PINCTRL=y
CONFIG_AW_PINCTRL_SUN65IW1=y
CONFIG_AW_PINCTRL_SUN65IW1_R=y

# A333 early IRQ domains
CONFIG_AW_WAKEUPGEN=y
CONFIG_AW_SUN8I_NMI=y

# A333 early eMMC power dependency chain
CONFIG_AW_DMA=y
CONFIG_AW_TWI=y
CONFIG_AW_MFD_AXP2101_I2C=y
CONFIG_AW_REGULATOR_AXP2101=y

# A333 display early power domain
CONFIG_AW_PCK600_DOMAINS=y

# Legacy /dev/fb0 interface required by dmx-panel
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y

# RAUC mounts signed .raucb bundles as loop-backed SquashFS images.
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8
CONFIG_MISC_FILESYSTEMS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y

# RAUC's format=verity bundles are SquashFS images exposed through dm-verity.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y

# AIC must toggle the board rails and rescan physical SDC1 via sunxi-rfkill.
# The Ubuntu branch assumes an already powered adapter and times out instead.
CONFIG_AW_RFKILL=y
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_PLATFORM_ALLWINNER=y
# CONFIG_PLATFORM_UBUNTU is not set
CONFIG_AIC8800_WLAN_SUPPORT=m
CONFIG_AIC8800_BTLPM_SUPPORT=m
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y

# dmx-panel owns the framebuffer; no kernel text console on the LCD
# CONFIG_FRAMEBUFFER_CONSOLE is not set
