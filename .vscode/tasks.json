{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "media-panel: regenerate EEZ UI",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/media-panel-eez.sh", "generate", "${input:eezProject}"],
      "options": {"cwd": "${workspaceFolder}", "env": {"EEZ_STUDIO": "${input:eezStudio}"}},
      "problemMatcher": []
    },
    {
      "label": "SDK kernel: refresh headers and IntelliSense",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/kernel-vscode.sh", "${input:kernelProfile}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "media-panel: build",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/media-panel-dev.sh", "build", "${input:profile}"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "media-panel: deploy",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/media-panel-dev.sh", "deploy", "${input:profile}", "${input:target}"],
      "problemMatcher": []
    },
    {
      "label": "media-panel: run (build + deploy + logs)",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/media-panel-dev.sh", "cycle", "${input:profile}", "${input:target}"],
      "problemMatcher": []
    },
    {
      "label": "media-panel: production logs",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/media-panel-dev.sh", "logs", "${input:profile}", "${input:target}"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "eezProject",
      "type": "promptString",
      "description": "EEZ project to generate/export into the SDK",
      "default": "oem/a333/src/media-panel/eez/lvgl-media-player.eez-project"
    },
    {
      "id": "eezStudio",
      "type": "promptString",
      "description": "EEZ Studio 0.29.0 executable / AppImage",
      "default": "/home/dmitrij999/apps/EEZ-Studio-0.29.0.AppImage"
    },
    {
      "id": "kernelProfile",
      "type": "pickString",
      "description": "Built kernel profile to index",
      "options": ["dmx", "media", "headless", "dmx-kernel-debug-logs", "media-kernel-debug-logs", "headless-kernel-debug-logs"],
      "default": "media"
    },
    {
      "id": "profile",
      "type": "pickString",
      "description": "SDK/profile matching the firmware on the board",
      "options": ["media", "media-kernel-debug-logs"],
      "default": "media"
    },
    {
      "id": "target",
      "type": "promptString",
      "description": "SSH target or ~/.ssh/config alias",
      "default": "root@192.168.0.144"
    }
  ]
}
