{
  "cmake.configureOnOpen": false,
  "cmake.sourceDirectory": "${workspaceFolder}/oem/a333/src/media-panel",
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.enhancedColorization": "enabled",
  "files.associations": {
    "*.h": "c",
    "**/media-panel/ui/eez-flow.h": "cpp",
    "**/media-panel/ui/vars.h": "cpp"
  },
  "files.watcherExclude": {
    "**/output/**": true,
    "**/dl/**": true,
    "**/ccache/**": true
  }
}
