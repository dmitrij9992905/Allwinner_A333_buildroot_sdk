[Unit]
Description=Bluetooth Cover Art OBEX client on the system bus
Requires=dbus.service
After=dbus.service bluetooth.service
Before=a333-media-backend.service

[Service]
Type=dbus
BusName=org.bluez.obex
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
# BlueZ 5.79 requires a server driver even for its Cover Art client.
# Keep only OPP and its transport/filesystem; do not enable --auto-accept.
ExecStart=/usr/libexec/bluetooth/obexd --nodetach --plugin=bluetooth,filesystem,opp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
