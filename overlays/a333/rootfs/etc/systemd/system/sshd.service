[Unit]
Description=OpenSSH server daemon
After=a333-userdata.service network.target
Requires=a333-userdata.service

[Service]
ExecStartPre=/usr/sbin/a333-ssh-hostkeys
ExecStart=/usr/sbin/sshd -D -e
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
