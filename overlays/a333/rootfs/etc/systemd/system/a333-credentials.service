[Unit]
Description=Mount factory device identity and cloud credentials read-only
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/a333-mount-credentials start
ExecStop=/usr/sbin/a333-mount-credentials stop
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
