# Allwinner sunxi_flash environment stored in the two A/B metadata partitions.
# These numbers match sys_partition-ab.fex: p1 boot-resource, p2 env, p3
# env-redund, p4 bootA, p5 bootB, p6 rootfsA, p7 rootfsB, p8 oemA, p9 oemB.
# Override this file if the final flashing layout changes.
/dev/mmcblk0p2 0x0 0x20000
/dev/mmcblk0p3 0x0 0x20000
