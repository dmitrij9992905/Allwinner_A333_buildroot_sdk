#!/bin/sh
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
export LC_ALL=C
. /usr/libexec/a333-storage.sh
if [ "$#" -ne 2 ] || [ "$1" != --confirm ]; then
    echo "Usage: a333-provision-credentials --confirm <credentials.ext4>" >&2
    echo "Factory use only: replaces the named credentials partition. Stop cloud clients first." >&2
    exit 2
fi
[ "$(id -u)" -eq 0 ] || { echo "credentials: root is required" >&2; exit 1; }
image=$2
# A factory payload must be a regular file, not another raw device.
[ -f "$image" ] && [ ! -L "$image" ] || exit 1
image=$(readlink -f "$image")
case "$image" in /credentials|/credentials/*) echo "credentials: image must be outside /credentials" >&2; exit 1 ;; esac
[ "$(stat -c %s "$image")" -eq 16777216 ] || { echo "credentials: expected a 16 MiB image" >&2; exit 1; }
[ "$(blkid -p -s TYPE -o value "$image")" = ext4 ] || exit 1
[ "$(blkid -p -s LABEL -o value "$image")" = credentials ] || exit 1
# Check the source WITHOUT repairs; never write to an invalid factory image.
e2fsck -fn "$image" || exit 1
device=$(a333_partition_device credentials) || { echo "credentials: named partition unavailable" >&2; exit 1; }
[ "$(blockdev --getsize64 "$device")" -eq 16777216 ] || exit 1
expected=$(sha256sum "$image" | awk '{print $1}')
# Refuse busy mounts. There is no automatic read-write remount or formatting.
systemctl stop a333-credentials.service
/usr/sbin/a333-mount-credentials stop
dd if="$image" of="$device" bs=1M conv=fsync
actual=$(dd if="$device" bs=1M count=16 | sha256sum | awk '{print $1}')
[ "$actual" = "$expected" ] || { echo "credentials: readback mismatch; leaving unmounted" >&2; exit 1; }
# Restart also clears a previously failed unit after an interrupted factory
# provisioning, so future cloud clients can depend on its actual success.
systemctl restart a333-credentials.service
echo "credentials: factory image installed and verified; mounted read-only"
