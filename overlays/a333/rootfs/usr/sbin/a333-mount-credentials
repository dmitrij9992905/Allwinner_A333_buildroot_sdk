#!/bin/sh
set -eu
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
. /usr/libexec/a333-storage.sh

case "${1:-start}" in
    start)
        device=$(a333_partition_device credentials) || {
            echo "a333-mount-credentials: GPT partition credentials unavailable; no formatting or fallback" >&2
            exit 1
        }
        filesystem=$(blkid -p -s TYPE -o value "$device") || exit 1
        [ "$filesystem" = ext4 ] || {
            echo "a333-mount-credentials: expected ext4; preserving existing data" >&2
            exit 1
        }
        if mountpoint -q /credentials; then
            options=$(findmnt -n -o OPTIONS --mountpoint /credentials)
            case ",$options," in
                *,ro,*) exit 0 ;;
                *) echo "a333-mount-credentials: refusing existing writable mount" >&2; exit 1 ;;
            esac
        fi
        # noload prevents journal replay from writing even with a ro mount.
        # Never fsck, initialise or auto-generate an identity on this device.
        mount -t ext4 -o ro,noload,nodev,nosuid,noexec,noatime "$device" /credentials
        ;;
    stop)
        if mountpoint -q /credentials; then umount /credentials; fi
        ;;
    *) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac
