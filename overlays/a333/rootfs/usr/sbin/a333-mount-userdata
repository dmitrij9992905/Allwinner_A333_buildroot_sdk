#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
umask 022

userdata_device()
{
    device="$(sed -n 's/.*[[:space:]]userdata=\([^[:space:]]*\).*/\1/p' /proc/cmdline)"
    if [ -n "$device" ] && [ -b "$device" ]; then
        printf '%s\n' "$device"
        return 0
    fi
    for link in /dev/disk/by-partlabel/userdata /dev/disk/by-name/userdata /dev/mmcblk0p10; do
        if [ -e "$link" ]; then
            readlink -f "$link"
            return 0
        fi
    done
    return 1
}

wait_for_userdata()
{
    i=0
    while [ "$i" -lt 40 ]; do
        if device="$(userdata_device 2>/dev/null)" && [ -b "$device" ]; then
            printf '%s\n' "$device"
            return 0
        fi
        i=$((i + 1))
        sleep 0.25
    done
    return 1
}

populate_skeleton()
{
    mkdir -p /userdata/var/lib /userdata/var/cache /userdata/var/log \
        /userdata/home /userdata/root /userdata/media/music \
        /userdata/media/playlists /userdata/var/lib/mpd
    if [ -d /usr/share/a333/userdata-skel ]; then
        cp -a /usr/share/a333/userdata-skel/. /userdata/
    fi
    touch /userdata/.a333-userdata-initialized
}

prepare_userdata_directories()
{
    # Recreate required directories on EVERY boot, including after an OTA.
    # Never copy defaults over existing user files or depend on the first-boot
    # marker: newly installed services may need new state directories.
    mkdir -p /userdata/var/lib/systemd /userdata/var/lib/mpd \
        /userdata/var/lib/rauc /userdata/var/cache /userdata/var/log \
        /userdata/home /userdata/root /userdata/media/music \
        /userdata/media/playlists
    mkdir -p /userdata/var/lib/NetworkManager/system-connections \
        /userdata/var/lib/bluetooth /userdata/var/lib/ssh \
        /userdata/var/lib/private /userdata/var/cache/private \
        /userdata/var/log/private
    chmod 0700 /userdata/root \
        /userdata/var/lib/NetworkManager/system-connections \
        /userdata/var/lib/bluetooth /userdata/var/lib/ssh \
        /userdata/var/lib/private /userdata/var/cache/private \
        /userdata/var/log/private

    # PID 1 has established the machine ID before starting this service.
    # The journal directory must exist on the NEW /var/log before flush.
    machine_id="$(cat /etc/machine-id)"
    case "$machine_id" in
        ''|*[!0-9a-f]*)
            echo "a333-mount-userdata: invalid machine ID; refusing journal setup" >&2
            return 1
            ;;
    esac
    if [ "${#machine_id}" -ne 32 ]; then
        echo "a333-mount-userdata: invalid machine ID length" >&2
        return 1
    fi
    mkdir -p /userdata/var/log/journal "/userdata/var/log/journal/$machine_id"
    chown root:systemd-journal /userdata/var/log/journal \
        "/userdata/var/log/journal/$machine_id"
    chmod 2755 /userdata/var/log/journal "/userdata/var/log/journal/$machine_id"
}

bind_persistent()
{
    source="$1"
    target="$2"
    mkdir -p "$source" "$target"
    if ! mountpoint -q "$target"; then
        mount --bind "$source" "$target"
    fi
}

prepare_userdata_filesystem()
{
    device="$1"
    # Low-level probing avoids blkid's cache. Failure is NOT proof of emptiness.
    if filesystem="$(blkid -p -s TYPE -o value "$device")"; then
        if [ "$filesystem" != ext4 ]; then
            echo "a333-mount-userdata: refusing to overwrite filesystem '$filesystem' on $device" >&2
            return 1
        fi
    else
        probe_rc=$?
        if [ "$probe_rc" -ne 2 ] || [ -n "$filesystem" ]; then
            echo "a333-mount-userdata: probe failed ($probe_rc) for $device; preserving data" >&2
            return 1
        fi
        echo "a333-mount-userdata: no filesystem signature; checking ALL bytes of $device"
        if ! python3 /usr/libexec/a333-userdata-is-blank "$device"; then
            echo "a333-mount-userdata: device is not provably blank; refusing to format $device" >&2
            return 1
        fi
        echo "a333-mount-userdata: initialising verified all-zero device $device"
        mkfs.ext4 -F -L userdata "$device" || return 1
    fi
    # Preen only while unmounted. Replay the journal and repair only errors
    # e2fsck considers safe to fix automatically, never use a blanket '-y'.
    echo "a333-mount-userdata: checking and safely repairing ext4 on $device"
    if e2fsck -p "$device"; then
        check_rc=0
    else
        check_rc=$?
    fi
    case "$check_rc" in
        0) ;;
        1) echo "a333-mount-userdata: filesystem errors corrected on $device" ;;
        *)
            echo "a333-mount-userdata: e2fsck returned $check_rc for $device; refusing mount, resize and format" >&2
            echo "a333-mount-userdata: back up data and perform manual offline recovery before retrying" >&2
            return 1
            ;;
    esac
    # Preserve diagnostics and stop on errors; never reformat an existing ext4.
    if ! resize2fs -P "$device"; then
        echo "a333-mount-userdata: ext4 validation failed for $device; preserving data" >&2
        return 1
    fi
}

mount_userdata()
{
    if mountpoint -q /userdata; then
        return 0
    fi
    device="$(wait_for_userdata || true)"
    if [ -z "$device" ]; then
        echo "a333-mount-userdata: userdata partition is not available" >&2
        return 1
    fi
    for tool in blkid e2fsck resize2fs; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            echo "a333-mount-userdata: $tool is missing; preserving data" >&2
            return 1
        fi
    done
    prepare_userdata_filesystem "$device" || return 1
    if command -v a333-expand-userdata >/dev/null 2>&1; then
        if a333-expand-userdata; then
            :
        else
            rc=$?
            if [ "$rc" -eq 10 ]; then
                echo "a333-mount-userdata: partition expanded; rebooting once"
                systemctl reboot
                exit 0
            fi
            return "$rc"
        fi
    fi
    mkdir -p /userdata
    mount -t ext4 -o noatime,nodev,nosuid "$device" /userdata
    if ! resize2fs "$device"; then
        echo "a333-mount-userdata: expansion failed for $device; preserving data" >&2
        umount /userdata || true
        return 1
    fi
    if [ ! -f /userdata/.a333-userdata-initialized ]; then
        populate_skeleton
    fi
    prepare_userdata_directories
    bind_persistent /userdata/var/lib /var/lib
    bind_persistent /userdata/var/cache /var/cache
    bind_persistent /userdata/var/log /var/log
    bind_persistent /userdata/home /home
    bind_persistent /userdata/root /root
}

unmount_userdata()
{
    for target in /root /home /var/log /var/cache /var/lib; do
        if mountpoint -q "$target"; then
            umount "$target"
        fi
    done
    if mountpoint -q /userdata; then
        umount /userdata
    fi
}

case "${1:-start}" in
    start) mount_userdata ;;
    stop) unmount_userdata ;;
    *) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac
