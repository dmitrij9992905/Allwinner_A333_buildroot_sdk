From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Buildroot A333 project <noreply@localhost>
Date: Sun, 16 Aug 2026 00:00:00 +0300
Subject: [PATCH] sunxi: make native A/B switcher safe for Linux root devices

The vendor switcher assumes all optional environment variables exist and uses
the partition name only for root selection. Buildroot needs the selected block
device as well. Keep the vendor partition names for U-Boot image lookup and
copy rootdevA/rootdevB into mmc_root for the Linux command line.

---
 board/sunxi/sunxi_switch_system.c | 22 +++++++++++++++++-----
 1 file changed, 17 insertions(+), 5 deletions(-)

diff --git a/board/sunxi/sunxi_switch_system.c b/board/sunxi/sunxi_switch_system.c
index 1234567..89abcde 100644
--- a/board/sunxi/sunxi_switch_system.c
+++ b/board/sunxi/sunxi_switch_system.c
@@ -27,45 +27,54 @@ static int __switch_systemAB(char *system)
 {
 	char tmp_system[5] = {0};
 	char *systemA = NULL;
 	char *systemB = NULL;
 	char *rootfsA = NULL;
 	char *rootfsB = NULL;
+	char *rootdevA = NULL;
+	char *rootdevB = NULL;
 	char *systemAB_damage = env_get("systemAB_damage");
 	char *systemAB_now = env_get("systemAB_now");
-	memcpy(tmp_system, system, sizeof(tmp_system));
+	tmp_system[0] = system[0];
+	tmp_system[1] = '\0';
 
 	if (!strcmp(tmp_system, "A")) {
-		if (strcmp(systemAB_damage, "A"))
+		if (systemAB_damage && strcmp(systemAB_damage, "A"))
 			printf("SWITCH WARNING : systemA is damaged\n");
 
-		if ((!strcmp(systemAB_now, "B")) || (!systemAB_now)) {
+		if ((!systemAB_now || !strcmp(systemAB_now, "B"))) {
 			systemA = env_get("systemA");
 			rootfsA = env_get("rootfsA");
+			rootdevA = env_get("rootdevA");
 			env_set("boot_partition", systemA);
 			env_set("root_partition", rootfsA);
+			if (rootdevA)
+				env_set("mmc_root", rootdevA);
 			env_set("systemAB_now", "A");
 			env_save();
 			printf("boot system %s\n", tmp_system);
 			return 0;
 		}
 	} else if (!strcmp(tmp_system, "B")) {
-		if (strcmp(systemAB_damage, "B"))
+		if (systemAB_damage && strcmp(systemAB_damage, "B"))
 			printf("SWITCH WARNING : systemB is damaged\n");
 
-		if ((!strcmp(systemAB_now, "A")) || (!systemAB_now)) {
+		if ((!systemAB_now || !strcmp(systemAB_now, "A"))) {
 			systemB = env_get("systemB");
 			rootfsB = env_get("rootfsB");
+			rootdevB = env_get("rootdevB");
 			env_set("boot_partition", systemB);
 			env_set("root_partition", rootfsB);
+			if (rootdevB)
+				env_set("mmc_root", rootdevB);
 			env_set("systemAB_now", "B");
 			env_save();
 			printf("boot system %s\n", tmp_system);
 			return 0;
 		}
 	} else {
 		printf("SWITCH ERROR : input system is %s\n", tmp_system);
 		printf("               Please input A or B system\n");
 		return -1;
 	}
 	return 0;
 }

