&pio {
	spi0_pins_default: spi0@0 {
		pins = "PC0", "PC2", "PC3"; /* clk, mosi, miso */
		function = "spi0";
		drive-strength = <10>;
	};

	spi0_pins_cs: spi0@1 {
		pins = "PC1", "PC4", "PC5";
		function = "spi0";
		drive-strength = <10>;
		bias-pull-up;   /* cs, hold, wp should be pulled up */
	};

	twi5_pins_a: twi5@0 {
		allwinner,pins = "PH18", "PH19";
		allwinner,pname = "twi5_scl", "twi5_sda";
		allwinner,function = "twi5";
		allwinner,muxsel = <2>;
		allwinner,drive = <1>;
		allwinner,pull = <1>;
	};

	twi5_pins_b: twi5@1 {
		allwinner,pins = "PH18", "PH19";
		allwinner,function = "gpio_out";
		allwinner,muxsel = <1>;
		allwinner,drive = <1>;
		allwinner,pull = <1>;
	};

};

