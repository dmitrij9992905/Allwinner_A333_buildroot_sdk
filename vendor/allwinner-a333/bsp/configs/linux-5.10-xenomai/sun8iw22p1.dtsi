		uart9: uart@2609000 {
			compatible = "allwinner,uart-v101";
			reg = <0x0 0x02609000 0x0 0x400>;
			interrupts = <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_UART9_APB>;
			resets = <&ccu RST_BUS_UART9>;
			uart9_port = <9>;
			uart9_type = <4>;
			sunxi,uart-fifosize = <64>;
			dmas = <&dma 56>, <&dma 56>;
			dma-names = "fake_tx", "fake_rx";
			//dma-names = "tx", "rx";
			status = "disabled";
		};

		ths: ths@2086000 {
			compatible = "allwinner,sun8iw22p1-ths";
			reg = <0x0 0x02086000 0x0 0x200>;
			clocks = <&ccu CLK_BUS_TSENSOR_APB>, <&ccu CLK_GPADC3>;
			clock-names = "bus","gpadc";
			resets = <&ccu RST_BUS_TSENSO>;
			#thermal-sensor-cells = <1>;
		};

		dump_reg: dump_reg@40000 {
			compatible = "allwinner,sunxi-dump-reg";
			reg = <0x0 0x00040000 0x0 0x0004>;
		};

		timer0: timer0@1A08000{
			compatible = "allwinner,hstimer-v100";
			device_type = "timer0";
			reg = <0x0 0x01A08000 0x0 0x400>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>;
			clock-names = "parent", "bus", "timer0-mod", "timer1-mod";
			clocks = <&dcxo24M>, <&ccu CLK_BUS_TIMER0_RV_AHB>, <&ccu CLK_TIMER0_0_RV_CLK>, <&ccu CLK_TIMER0_1_RV_CLK>;
			resets = <&ccu RST_BUS_TIMER0_RV>;
		};

		rtc: rtc@7090000 {
			compatible = "allwinner,rtc-v201";
			device_type = "rtc";
			wakeup-source;
			reg = <0x0 0x07090000 0x0 0x320>;
			interrupts = <GIC_SPI 200 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&r_ccu CLK_BUS_RTC>, <&rtc_ccu CLK_RTC_1K>, <&rtc_ccu CLK_RTC_SPI>;
			clock-names = "r-ahb-rtc", "rtc-1k", "rtc-spi";
			resets = <&r_ccu RST_BUS_RTC>;
			gpr_cur_pos = <6>;
			gpr_bootcount_pos = <7>;
			reboot-reason-offset = <0x240>;
		};

		sid: sid@3006000 {
			compatible = "allwinner,sunxi-sid";
			reg = <0x0 0x03006000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			non-secure-maxoffset = <0x50>;
			non-secure-maxlen = <0x10>;

			chipid {
				reg = <0x0 0>;
				offset = <0x200>;
				size = <0x10>;
			};
			dvfs_ori {
				offset = <0x220>;
				shift = <16>;
				mask = <0xff>;
			};
			dvfs_bak {
				offset = <0x220>;
				shift = <24>;
				mask = <0xff>;
			};
		};

		sram_ctrl: sram_ctrl@3000000 {
			compatible = "allwinner,sram_ctrl";
			reg = <0x0 0x03000000 0 0x184>;
			soc_ver {
				offset = <0x24>;
				mask = <0x7>;
				shift = <0>;
			};
		};

		sdc2: sdmmc@4022000 {
			compatible = "allwinner,sunxi-mmc-v4p6x";
			device_type = "sdc2";
			reg = <0x0 0x04022000 0x0 0x1000>;
			interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dcxo24M>,
				 <&ccu CLK_PLL_PERI1_800M>,
				 <&ccu CLK_PLL_PERI1_600M>,
				 <&ccu CLK_SMHC2>,
				 <&ccu CLK_BUS_SMHC2_AHB>;
			clock-names = "osc24m","pll_periph","pll_periph_2","mmc","ahb";
			resets = <&ccu RST_BUS_SMHC2>;
			reset-names = "rst";
			pinctrl-names = "default","sleep";
			pinctrl-0 = <&sdc2_pins_a &sdc2_pins_c>;
			pinctrl-1 = <&sdc2_pins_b>;
			bus-width = <8>;
			req-page-count = <2>;
			cap-mmc-highspeed;
			cap-cmd23;
			mmc-cache-ctrl;
			non-removable;
			/*max-frequency = <200000000>;*/
			max-frequency = <50000000>;
			cap-erase;
			mmc-high-capacity-erase-size;
			no-sdio;
			no-sd;
			/*-- speed mode --*/
			/*sm0: DS26_SDR12*/
			/*sm1: HSSDR52_SDR25*/
			/*sm2: HSDDR52_DDR50*/
			/*sm3: HS200_SDR104*/
			/*sm4: HS400*/
			/*-- frequency point --*/
			/*f0: CLK_400K*/
			/*f1: CLK_25M*/
			/*f2: CLK_50M*/
			/*f3: CLK_100M*/
			/*f4: CLK_150M*/
			/*f5: CLK_200M*/
			ctl-spec-caps = <0x328>;
			sdc_tm4_sm0_freq0 = <0>;
			sdc_tm4_sm0_freq1 = <0>;
			sdc_tm4_sm1_freq0 = <0x00000000>;
			sdc_tm4_sm1_freq1 = <0>;
			sdc_tm4_sm2_freq0 = <0x00000000>;
			sdc_tm4_sm2_freq1 = <0>;
			sdc_tm4_sm3_freq0 = <0x05000000>;
			sdc_tm4_sm3_freq1 = <0x00000005>;
			sdc_tm4_sm4_freq0 = <0x00050000>;
			sdc_tm4_sm4_freq1 = <0x00000004>;
			sdc_tm4_sm4_freq0_cmd = <0>;
			sdc_tm4_sm4_freq1_cmd = <0>;

			/*vmmc-supply = <&reg_3p3v>;*/
			/*vqmc-supply = <&reg_3p3v>;*/
			/*vdmc-supply = <&reg_3p3v>;*/
			/*vmmc = "vcc-card";*/
			/*vqmc = "";*/
			/*vdmc = "";*/
			/*sunxi-power-save-mode;*/
		};

		sdc0: sdmmc@4020000 {
			compatible = "allwinner,sunxi-mmc-v5p3x";
			device_type = "sdc0";
			reg = <0x0 0x04020000 0x0 0x1000>;
			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dcxo24M>,
				 <&ccu CLK_PLL_PERI1_400M>,
				 <&ccu CLK_PLL_PERI1_300M>,
				 <&ccu CLK_SMHC0>,
				 <&ccu CLK_BUS_SMHC0_AHB>;
			clock-names = "osc24m","pll_periph","pll_periph_2","mmc","ahb";
			resets = <&ccu RST_BUS_SMHC0>;
			reset-names = "rst";
			pinctrl-names = "default","mmc_1v8","sleep","uart_jtag";
			pinctrl-0 = <&sdc0_pins_a>;
			pinctrl-1 = <&sdc0_pins_b>;
			pinctrl-2 = <&sdc0_pins_c>;
			pinctrl-3 = <&sdc0_pins_d &sdc0_pins_e>;
			max-frequency = <50000000>;
			bus-width = <4>;
			req-page-count = <2>;
			/*non-removable;*/
			/*broken-cd;*/
			/*cd-inverted*/
			/*cd-gpios = <&pio PF 6 GPIO_ACTIVE_LOW>;*/
			/* vmmc-supply = <&reg_3p3v>;*/
			/* vqmc-supply = <&reg_3p3v>;*/
			/* vdmc-supply = <&reg_3p3v>;*/
			/*vmmc = "vcc-card";*/
			/*vqmc = "";*/
			/*vdmc = "";*/
			cap-sd-highspeed;
			cap-wait-while-busy;
			/*sd-uhs-sdr50;*/
			/*sd-uhs-ddr50;*/
			/*cap-sdio-irq;*/
			/*keep-power-in-suspend;*/
			/*ignore-pm-notify;*/
			/*sunxi-power-save-mode;*/
			/*sunxi-dly-400k = <1 0 0 0>; */
			/*sunxi-dly-26M  = <1 0 0 0>;*/
			/*sunxi-dly-52M  = <1 0 0 0>;*/
			/*sunxi-dly-52M-ddr4  = <1 0 0 0>;*/
			/*sunxi-dly-52M-ddr8  = <1 0 0 0>;*/
			/*sunxi-dly-104M  = <1 0 0 0>;*/
			/*sunxi-dly-208M  = <1 0 0 0>;*/
			/*sunxi-dly-104M-ddr  = <1 0 0 0>;*/
			/*sunxi-dly-208M-ddr  = <1 0 0 0>;*/
			ctl-spec-caps = <0x428>;
			status = "disabled";
		};

		sdc1: sdmmc@4021000 {
			compatible = "allwinner,sunxi-mmc-v5p3x";
			device_type = "sdc1";
			reg = <0x0 0x04021000 0x0 0x1000>;
			interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dcxo24M>,
				 <&ccu CLK_PLL_PERI1_400M>,
				 <&ccu CLK_PLL_PERI1_300M>,
				 <&ccu CLK_SMHC1>,
				 <&ccu CLK_BUS_SMHC1_AHB>;
			clock-names = "osc24m","pll_periph","pll_periph_2","mmc","ahb";
			resets = <&ccu RST_BUS_SMHC1>;
			reset-names = "rst";
			pinctrl-names = "default","sleep";
			pinctrl-0 = <&sdc1_pins_a>;
			pinctrl-1 = <&sdc1_pins_b>;
			max-frequency = <50000000>;
			bus-width = <4>;
			/*broken-cd;*/
			/*cd-inverted*/
			/*cd-gpios = <&pio PG 6 6 1 2 0>;*/
			/* vmmc-supply = <&reg_3p3v>;*/
			/* vqmc-supply = <&reg_3p3v>;*/
			/* vdmc-supply = <&reg_3p3v>;*/
			/*vmmc = "vcc-card";*/
			/*vqmc = "";*/
			/*vdmc = "";*/
			cap-sd-highspeed;
			cap-sdio-irq;
			ignore-pm-notify;
			/*sd-uhs-sdr50;*/
			/*sd-uhs-ddr50;*/
			/*sd-uhs-sdr104;*/
			/*cap-sdio-irq;*/
			keep-power-in-suspend;
			/*ignore-pm-notify;*/
			/*sunxi-power-save-mode;*/
			/*sunxi-dly-400k = <1 0 0 0 0 0>;*/
			/*sunxi-dly-26M  = <1 0 0 0 0 0>;*/
			/*sunxi-dly-52M  = <1 0 0 0 0 0>;*/
			/*sunxi-dly-52M-ddr4  = <1 0 0 0 0 2>;*/
			/*sunxi-dly-52M-ddr8  = <1 0 0 0 0 0>;*/
			/*sunxi-dly-104M  = <1 0 0 0 0 1>;*/
			/*sunxi-dly-208M  = <1 1 0 0 0 0>;*/
			/*sunxi-dly-208M  = <1 0 0 0 0 1>;*/
			/*sunxi-dly-104M-ddr  = <1 0 0 0 0 0>;*/
			/*sunxi-dly-208M-ddr  = <1 0 0 0 0 0>;*/

			execute_tuning_in_kernel;
			ctl-spec-caps = <0x428>;
			status = "disabled";
		};

		sdc3: sdmmc@4023000 {
			compatible = "allwinner,sunxi-mmc-v5p3x";
			device_type = "sdc3";
			reg = <0x0 0x04023000 0x0 0x1000>;
			interrupts = <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dcxo24M>,
				 <&ccu CLK_PLL_PERI0_400M>,
				 <&ccu CLK_SMHC3>,
				 <&ccu CLK_BUS_SMHC3_AHB>;
			clock-names = "osc24m","pll_periph","mmc","ahb";
			resets = <&ccu RST_BUS_SMHC3>;
			reset-names = "rst";
			pinctrl-names = "default","sleep";
			pinctrl-0 = <&sdc1_pins_a>;
			pinctrl-1 = <&sdc1_pins_b>;
			max-frequency = <50000000>;
			bus-width = <4>;
			/*broken-cd;*/
			/*cd-inverted*/
			/*cd-gpios = <&pio PG 6 6 1 2 0>;*/
			/* vmmc-supply = <&reg_3p3v>;*/
			/* vqmc-supply = <&reg_3p3v>;*/
			/* vdmc-supply = <&reg_3p3v>;*/
			/*vmmc = "vcc-card";*/
			/*vqmc = "";*/
			/*vdmc = "";*/
			cap-sd-highspeed;
			/*sd-uhs-sdr50;*/
			/*sd-uhs-ddr50;*/
			/*sd-uhs-sdr104;*/
			/*cap-sdio-irq;*/
			keep-power-in-suspend;
			/*ignore-pm-notify;*/
			/*sunxi-power-save-mode;*/
			/*sunxi-dly-400k = <1 0 0 0 0>; */
			/*sunxi-dly-26M  = <1 0 0 0 0>;*/
			/*sunxi-dly-52M  = <1 0 0 0 0>;*/
			sunxi-dly-52M-ddr4  = <1 0 0 0 2>;
			/*sunxi-dly-52M-ddr8  = <1 0 0 0 0>;*/
			sunxi-dly-104M  = <1 0 0 0 1>;
			/*sunxi-dly-208M  = <1 1 0 0 0>;*/
			sunxi-dly-208M  = <1 0 0 0 1>;
			/*sunxi-dly-104M-ddr  = <1 0 0 0 0>;*/
			/*sunxi-dly-208M-ddr  = <1 0 0 0 0>;*/

			status = "disabled";
		};

		spi0: spi@4025000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.5";
			reg = <0x0 0x04025000 0x0 0x1000>;
			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&ccu CLK_SPI0>, <&ccu CLK_BUS_SPI0_AHB>, <&ccu CLK_AHB>;
			clock-names = "pll", "mod", "bus", "ahb";
			resets = <&ccu RST_BUS_SPI0>;
			dmas = <&dma 22>, <&dma 22>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <2>;
			status = "disabled";
		};

		spi1: spi@4026000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.6";
			reg = <0x0 0x04026000 0x0 0x1000>;
			interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&ccu CLK_SPI1>, <&ccu CLK_BUS_SPI1_AHB>, <&ccu CLK_AHB>;
			clock-names = "pll", "mod", "bus", "ahb";
			resets = <&ccu RST_BUS_SPI1>;
			dmas = <&dma 23>, <&dma 23>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <1>;
			status = "disabled";
		};

		spi2: spi@4027000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.5";
			reg = <0x0 0x04027000 0x0 0x1000>;
			interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&ccu CLK_SPI2>, <&ccu CLK_BUS_SPI2_AHB>, <&ccu CLK_AHB>;
			clock-names = "pll", "mod", "bus", "ahb";
			resets = <&ccu RST_BUS_SPI2>;
			dmas = <&dma 24>, <&dma 24>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <2>;
			status = "disabled";
		};

		spi3: spi@4028000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-spi-v1.5";
			reg = <0x0 0x04028000 0x0 0x1000>;
			interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_PLL_PERI0_300M>, <&ccu CLK_SPI3>, <&ccu CLK_BUS_SPI3_AHB>, <&ccu CLK_AHB>;
			clock-names = "pll", "mod", "bus", "ahb";
			resets = <&ccu RST_BUS_SPI3>;
			dmas = <&dma 25>, <&dma 25>;
			dma-names = "tx", "rx";
			clock-frequency = <100000000>;
			sunxi,spi-num-cs = <1>;
			status = "disabled";
		};

		sunxi_drm: sunxi-drm {
			compatible = "allwinner,sunxi-drm";
			fb_base = <0>;
			status = "okay";
		};

		de: de@5000000 {
			compatible = "allwinner,display-engine-v212";
			/* iommus = <&mmu_aw 8 1>; */
			/* nsi = <&nsi0 2>; */
			reg = <0x0 0x5000000 0x0 0x400000>;
			interrupts = <GIC_SPI 87 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_DE>,
				 <&ccu CLK_BUS_DE0_AHB>;
			clock-names = "clk_de",
				      "clk_bus_de";
			resets = <&ccu RST_BUS_DE0>;
			reset-names = "rst_bus_de";
			assigned-clocks = <&ccu CLK_DE>;
			assigned-clock-parents = <&ccu CLK_PLL_PERI0_600M>;
			/* 300M is enough to meet 1080p input and output scenarios (1200 * 2000) */
			assigned-clock-rates = <300000000>;
			/* power-domains = <&pd SUN60IW2_PCK_DE_SYS>; */
			sys = <&vo0>;
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				disp0: port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					disp0_out_tcon0: endpoint@0 {
						reg = <0>;
						/* TODO, temp mask */
						remote-endpoint = <&tcon0_in_disp0>;
					};
				};
			};
		};

		vo0: vo0@5500000 {
			compatible = "allwinner,tcon-top0";
			reg = <0x0 0x05500000 0x0 0x1000>;
			clocks = <&ccu CLK_BUS_VO0_REG_AHB>,
				 <&ccu CLK_BUS_VIDEO_OUT0_AHB_SW_CFG>;
			clock-names = "clk_bus_dpss_top",
				"clk_ahb_gate";
			resets = <&ccu RST_BUS_VIDEO_OUT0>,
				 <&ccu RST_BUS_VO0_REG>;
			reset-names = "rst_bus_dpss_top",
					"rst_bus_reg";
			status = "okay";
		};

		dlcd0: tcon0@5501000 {
			compatible = "allwinner,tcon-lcd";
			reg = <0x0 0x05501000 0x0 0x1000>;
			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;

			clocks = <&ccu CLK_TCON_LCD0>,<&ccu CLK_BUS_TCON_LCD0_AHB>;
			clock-names = "clk_tcon","clk_bus_tcon";
			resets = <&ccu RST_BUS_TCON_LCD0>;
			reset-names = "rst_bus_tcon";
			top = <&vo0>;
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				tcon0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					tcon0_in_disp0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&disp0_out_tcon0>;
					};
			};
					tcon_out: port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;
						tcon0_out_dsi0: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dsi0_in_tcon0>;
						};
						tcon0_out_lvds0: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&lvds0_in_tcon0>;
						};
						tcon0_out_rgb0: endpoint@2 {
							reg = <2>;
							remote-endpoint = <&rgb0_in_tcon0>;
						};
					};
			};
		};

		dsi0combophy: phy@5507000 {
			compatible = "allwinner,sunxi-dsi-combo-phy0";
			reg = <0x0 0x05507000 0x0 0xfff>;
			clocks = <&ccu CLK_BUS_MIPI_DSI0_AHB>;
			clock-names = "phy_gating_clk";
			resets = <&ccu RST_BUS_MIPI_DSI0>;
			reset-names = "phy_rst_clk";
			#clock-cells = <1>;
			#phy-cells = <0>;
			status = "okay";
		};

		dsi0: dsi0@5506000 {
			compatible = "allwinner,dsi0";
			reg = <0x0 0x05506000 0x0 0xfff>;
			interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_MIPI_DSI0>,
					<&ccu CLK_BUS_MIPI_DSI0_AHB>,
					<&dsi0combophy CLK_DSI_HS>,
					<&dsi0combophy CLK_DSI_LS>;
			clock-names = "dsi_clk",
				      "dsi_gating_clk",
				      "displl_hs",
				      "displl_ls";
			resets = <&ccu RST_BUS_MIPI_DSI0>;
			reset-names = "dsi_rst_clk";
			phys = <&dsi0combophy>;
			phy-names = "combophy";
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				dsi0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					dsi0_in_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_out_dsi0>;
					};
				};
			};
		};


		rgb0: rgb0@1000 {
			compatible = "allwinner,rgb0";
			clocks = <&dsi0combophy CLK_LVDS_OR_RGB>;
			clock-names = "rgb_pclk";
			phys = <&dsi0combophy>;
			phy-names = "combophy0";
			status = "disabled";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				rgb0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					rgb0_in_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_out_rgb0>;
					};
				};
			};
		};

		lvds0: lvds0@1000 {
			compatible = "allwinner,lvds0";
			reg = <0x0 0x05501000 0x0 0xfff>;
			clocks = <&dsi0combophy CLK_LVDS_OR_RGB>;
			clock-names = "lvds_pclk";
			resets = <&ccu RST_BUS_LVDS0>;
			reset-names = "rst_bus_lvds";
			phys = <&dsi0combophy>;
			phy-names = "combophy0";
			status = "okay";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				lvds0_in: port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <0>;
					lvds0_in_tcon0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&tcon0_out_lvds0>;
					};
				};
			};
		};

		dma: dma-controller@3001000 {
			compatible = "allwinner,dma-v111";
			reg = <0x0 0x3001000 0x0 0x1000>;
			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_DMA0_AHB>, <&ccu CLK_MBUS_BUS_DMA0>, <&ccu CLK_MBUS_BUS_DMA0_SW_CFG>;
			clock-names = "bus", "mbus", "mbus-en";
			dma-channels = <16>;
			dma-requests = <64>;
			resets = <&ccu RST_BUS_DMA0>;
			#dma-cells = <1>;
		};

		dma1: dma1-controller@4000000 {
			compatible = "allwinner,dma-v111";
			reg = <0x0 0x4000000 0x0 0x1000>;
			interrupts = <GIC_SPI 164 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_DMA1_AHB>, <&ccu CLK_MBUS_BUS_DMA1>, <&ccu CLK_MBUS_BUS_DMA1_SW_CFG>;
			clock-names = "bus", "mbus", "mbus-en";
			dma-channels = <8>;
			dma-requests = <64>;
			resets = <&ccu RST_BUS_DMA1>;
			#dma-cells = <1>;
		};

		ce0: ce@3040000 {
			compatible = "allwinner,sunxi-ce";
			device_name = "ce";
			reg = <0x0 0x03040000 0x0 0x90>, /* non-secure space */
			      <0x0 0x03040800 0x0 0x9c>; /* secure space */
			interrupts = <GIC_SPI 52 IRQ_TYPE_LEVEL_HIGH>, /*non-secure*/
				   <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH>; /* secure*/
			clock-frequency = <400000000>; /* 400MHz */
			clocks = <&ccu CLK_BUS_CE_SYS_IP_AHB>, <&ccu CLK_BUS_CE_SYS>, <&ccu CLK_MBUS_BUS_CE_SYS>,
					<&ccu CLK_CE_SYS>;
			clock-names = "bus_ce", "ce_sys_clk", "mbus_ce", "ce_clk";
			resets = <&ccu RST_BUS_CE_SY>;
			reset-names = "rst_bus_ce";
			low-power-mode;
			status = "okay";
		};

		twi0: twi0@2510000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-twi-v104";
			device_type = "twi0";
			reg = <0x0 0x02510000 0x0 0x400>;
			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_TWI0_APB>, <&ccu CLK_APB1>;
			clock-names = "bus", "apb";
			resets = <&ccu RST_BUS_TWI0>;
			dmas = <&dma 43>, <&dma 43>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		twi1: twi1@2511000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-twi-v104";
			device_type = "twi1";
			reg = <0x0 0x02511000 0x0 0x400>;
			interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_TWI1_APB>, <&ccu CLK_APB1>;
			clock-names = "bus", "apb";
			resets = <&ccu RST_BUS_TWI1>;
			dmas = <&dma 44>, <&dma 44>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		twi2: twi2@2512000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-twi-v104";
			device_type = "twi2";
			reg = <0x0 0x02512000 0x0 0x400>;
			interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_TWI2_APB>, <&ccu CLK_APB1>;
			clock-names = "bus", "apb";
			resets = <&ccu RST_BUS_TWI2>;
			dmas = <&dma 45>, <&dma 45>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		twi3: twi3@2513000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-twi-v104";
			device_type = "twi3";
			reg = <0x0 0x02513000 0x0 0x400>;
			interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_TWI3_APB>, <&ccu CLK_APB1>;
			clock-names = "bus", "apb";
			resets = <&ccu RST_BUS_TWI3>;
			dmas = <&dma 46>, <&dma 46>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		twi4: twi4@2514000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-twi-v104";
			device_type = "twi4";
			reg = <0x0 0x02514000 0x0 0x400>;
			interrupts = <GIC_SPI 14 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_TWI4_APB>, <&ccu CLK_APB1>;
			clock-names = "bus", "apb";
			resets = <&ccu RST_BUS_TWI4>;
			dmas = <&dma 47>, <&dma 47>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		twi5: twi5@2515000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "allwinner,sunxi-twi-v104";
			device_type = "twi5";
			reg = <0x0 0x02515000 0x0 0x400>;
			interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_TWI5_APB>, <&ccu CLK_APB1>;
			clock-names = "bus", "apb";
			resets = <&ccu RST_BUS_TWI5>;
			dmas = <&dma 48>, <&dma 48>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		amp_ts0: amp_ts@8120000 {
			compatible = "sunxi,amp_timestamp";
			reg = <0x0 0x08120000 0x0 0x1000>;
			id = <0>;
			counter_type = <ARM_ARCH_COUNTER_TYPE>;
			count_freq = <24000000>;
			status = "okay";
		};


		gmac_stmmac_axi_setup: stmmac-axi-config {
			snps,lpi_en;
			snps,wr_osr_lmt = <0xf>;
			snps,rd_osr_lmt = <0xf>;
			snps,blen = <256 128 64 32 16 8 4>;
		};

		gmac_mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <1>;
			queue0 {};
		};

		gmac_mtl_tx_setup: tx_queues-config {
			snps,tx-queues-to-use = <1>;
			queue0 {};
		};

		gmac0: ethernet@4500000 {
			compatible = "allwinner,sunxi-gmac-211";
			reg = <0x0 0x04500000 0x0 0x8000>, <0x0 0x04508000 0x0 0x1000>;
			interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>,
						<GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq", "eth_lpi", "tx0_irq", "rx0_irq";
			clocks = <&ccu CLK_BUS_GMAC0_AHB>, <&ccu CLK_MBUS_BUS_GMAC0>, <&ccu CLK_GMAC0_PHY>, <&ccu CLK_GMAC0_PTP_REF>;
			clock-names = "stmmaceth", "pclk", "phy", "ptp_ref";
			assigned-clocks = <&ccu CLK_GMAC0_PHY>;
			assigned-clock-rates = <25000000>;
			resets = <&ccu RST_BUS_GMAC0_AXI>, <&ccu RST_BUS_GMAC0_AHB>;
			reset-names = "stmmaceth", "ahb";
			phy-mode = "rgmii";
			phy-handle = <&gmac0_phy0>;
			status = "disabled";

			aw,rgmii-clk-ext;
			snps,fixed-burst;
			snps,en-tx-lpi-clockgating;
			snps,axi-config = <&gmac_stmmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;

			mdio0: mdio0@0 {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
				gmac0_phy0: ethernet-phy@1 {
					compatible = "ethernet-phy-ieee802.3-c22";
					reg = <0x1>;
					max-speed = <1000>;  /* Max speed capability */
					reset-gpios = <&pio PA 14 GPIO_ACTIVE_LOW>;
					/* PHY datasheet rst time */
					reset-assert-us = <10000>;
					reset-deassert-us = <150000>;
				};
			};
		};

		usbc0: usbc0@10 {
			device_type = "usbc0";
			compatible = "allwinner,sunxi-otg-manager";
			reg = <0x0 0x10 0x0 0x1000>;
			usb_port_type = <2>;
			usb_detect_type = <1>;
			usb_detect_mode = <0>;
			usb_id_gpio;
			usb_det_vbus_gpio;
			usb_regulator_io = "nocare";
			usb_wakeup_suspend = <0>;
			usb_luns = <3>;
			usb_serial_unique = <0>;
			usb_serial_number = "20080411";
			rndis_wceis = <1>;
			status = "disabled";
		};

		udc:udc-controller@4200000 {
			compatible = "allwinner,sunxi-udc";
			reg = <0x0 0x04200000 0x0 0x1000>, /* udc base */
			      <0x0 0x00000000 0x0 0x100>;  /* sram base */
			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB0_DEV_AHB>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_otg", "usb_sys_ahb";
			resets = <&ccu RST_USB_0_DEV>, <&ccu RST_USB_2P0_SY>;
			reset-names = "otg", "usb_rst";
			phys = <&u2phy0>;
			phy-names = "usb2-phy";
			aw,dma_addr_extend;
			aw,dma_wordaddr_bypass = <0x1>;
			status = "disabled";
		};

		ehci0:ehci0-controller@4201000 {
			compatible = "allwinner,sunxi-ehci0";
			reg = <0x0 0x04201000 0x0 0xFFF>,  /*hci0 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x04200000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB0_EHCI_AHB>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "usb_sys_ahb";
			resets = <&ccu RST_USB_0_EHCI>,  <&ccu RST_USB_2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <0>;
			phys = <&u2phy0>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		ohci0:ohci0-controller@4201400 {
			compatible = "allwinner,sunxi-ohci0";
			reg = <0x0 0x04201400 0x0 0xFFF>,  /*hci0 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x04200000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB0_OHCI_AHB>, <&ccu CLK_BUS_USB0>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "ohci", "usb_sys_ahb";
			resets = <&ccu RST_USB_0_OHCI>, <&ccu RST_USB_2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <0>;
			phys = <&u2phy0>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		usbc1: usbc1@11 {
			device_type = "usbc1";
			reg = <0x0 0x11 0x0 0x1000>;
			usb_regulator_io = "nocare";
			usb_wakeup_suspend = <0>;
			status = "disabled";
		};

		ehci1: ehci1-controller@4300000 {
			compatible = "allwinner,sunxi-ehci1";
			reg = <0x0 0x04300000 0x0 0xFFF>,  /*ehci1 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x04200000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB1_EHCI_AHB>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "usb_sys_ahb";
			resets = <&ccu RST_USB_1_EHCI>, <&ccu RST_USB_2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <1>;
			phys = <&u2phy1>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		ohci1: ohci1-controller@4300400 {
			compatible = "allwinner,sunxi-ohci1";
			reg = <0x0 0x04300400 0x0 0xFFF>,  /*ohci1 base*/
			      <0x0 0x00000000 0x0 0x100>,  /*sram base*/
			      <0x0 0x04200000 0x0 0x1000>; /*otg base*/
			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_USB1_OHCI_AHB>, <&ccu CLK_BUS_USB1>, <&ccu CLK_BUS_USB2P0_SYS_AHB>;
			clock-names = "bus_hci", "ohci", "usb_sys_ahb";
			resets = <&ccu RST_USB_1_OHCI>, <&ccu RST_USB_2P0_SY>;
			reset-names = "hci", "usb_rst";
			hci_ctrl_no = <1>;
			phys = <&u2phy1>;
			phy-names = "usb2-phy";
			status = "disabled";
		};

		u2phy: phy@4100000 {
			compatible = "allwinner,sunxi-awphy-v101";
			reg = <0x0 0x04100000 0x0 0x100>, /* PHY Application Registers */
			      <0x0 0x04180000 0x0 0x100>; /* Digital Application Registers */
			reg-names = "phy_base", "top_base";
			clocks = <&ccu CLK_BUS_USB2P0_SYS_AHB>, <&ccu CLK_BUS_USB2P0_SYS_AHB_SW_CFG>;
			clock-names = "mclk", "pclk";
			resets = <&ccu RST_USB_2P0_SY>;
			reset-names = "usb_rst";
			#phy-cells = <0>;
			status = "disabled";

			u2phy0: u2-phy0 {
				clocks = <&ccu CLK_BUS_USB2P0_SYS_PHY_REF>;
				clock-names = "ref_clk";
				#phy-cells = <0>;
				status = "okay";
			};

			u2phy1: u2-phy1 {
				clocks = <&ccu CLK_BUS_USB2P0_SYS_PHY_REF>;
				clock-names = "ref_clk";
				#phy-cells = <0>;
				status = "okay";
			};

		};

		e907_rproc: e907_rproc@1a00000 {
			reg = <0x0 0x1a00000 0x0 0x1000>,
				<0x0 0x01a02000 0x0 0x400>,
				<0x0 0x02093000 0x0 0x400>;
			compatible = "allwinner,e907-rproc";
			/* core clk depend on vdd-sys, if vol equal with 0.94v, set core clk as 600M,
				set parent clk as CLK_PLL_PERI0_600M,otherwise if vol equla with 0.92v,
				core clk set as 480m, set parent clk as CLK_PLL_PERI0_480M */
			core-clock-frequency = <480000000>;
			axi-clock-frequency = <240000000>;
			clocks = <&ccu CLK_PLL_PERI0_480M>, <&ccu CLK_RV_CORE>, <&ccu CLK_RV_TS>, <&ccu CLK_BUS_RV_CFG>, <&ccu CLK_E907_AXI_CLK>,
				<&ccu CLK_BUS_RV_AXIMON>;
			clock-names = "input", "core-gate", "rv-ts-gate", "rv-cfg-gate", "axi-div", "axi-monitor";
			resets = <&ccu RST_BUS_RV_CFG>, <&ccu RST_BUS_RV_CORE>, <&ccu RST_BUS_RV_SY>, <&ccu RST_BUS_RV_AXIMON>;
			reset-names = "rv-cfg-rst", "core-rst", "rv-sys-rst", "rst-axi-monitor";

			firmware-name = "amp_rv0.bin";
			reg-names = "rv-cfg", "rproc_wdt_reg", "axi-monitor-cfg";

			interrupts = <GIC_SPI 185 IRQ_TYPE_LEVEL_HIGH>,
						<GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "rproc_wdt_irq", "rproc_ecc_irq";
			status = "disabled";
		};

		pwm2: pwm2@20c0000 {
			#pwm-cells = <0x3>;
			compatible = "allwinner,sunxi-pwm-v203";
			reg = <0x0 0x020c0000 0x0 0x400>;
			clocks = <&ccu CLK_BUS_PWM2_APB>;
			interrupts = <GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&ccu RST_BUS_PWM2>;
			pwm-number = <14>;
			pwm-base = <0x0>;
			sunxi-pwms = <&pwm2_0>, <&pwm2_1>, <&pwm2_2>, <&pwm2_3>, <&pwm2_4>
					,<&pwm2_5>, <&pwm2_6>, <&pwm2_7>, <&pwm2_8>, <&pwm2_9>
					,<&pwm2_10>, <&pwm2_11>, <&pwm2_12>, <&pwm2_13>;
			status = "okay";
		};

		pwm2_0: pwm2@20c0010 {
			compatible = "allwinner,sunxi-pwm0";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0010 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_1: pwm2@20c0020 {
			compatible = "allwinner,sunxi-pwm1";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0020 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_2: pwm2@20c0030 {
			compatible = "allwinner,sunxi-pwm2";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0030 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_3: pwm2@20c0040 {
			compatible = "allwinner,sunxi-pwm3";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0040 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_4: pwm2@20c0050 {
			compatible = "allwinner,sunxi-pwm4";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0050 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_5: pwm2@20c0060 {
			compatible = "allwinner,sunxi-pwm5";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0060 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_6: pwm2@20c0070 {
			compatible = "allwinner,sunxi-pwm6";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0070 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_7: pwm2@20c0080 {
			compatible = "allwinner,sunxi-pwm7";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0080 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_8: pwm2@20c0090 {
			compatible = "allwinner,sunxi-pwm8";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c0090 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_9: pwm2@20c00a0 {
			compatible = "allwinner,sunxi-pwm9";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c00a0 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_10: pwm2@20c00b0 {
			compatible = "allwinner,sunxi-pwm10";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c00b0 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_11: pwm2@20c00c0 {
			compatible = "allwinner,sunxi-pwm11";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c00c0 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_12: pwm2@20c00d0 {
			compatible = "allwinner,sunxi-pwm12";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c00d0 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		pwm2_13: pwm2@20c00e0 {
			compatible = "allwinner,sunxi-pwm13";
			pinctrl-names = "active", "sleep";
			reg = <0x0 0x020c00e0 0x0 0x4>;
			reg_base = <0x020c0000>;
			status = "disabled";
		};

		/*
		 * Channel0~3 : cpux -> mcu
		 */
		msgbox: msgbox@3003000 {
			compatible = "allwinner,sun8iw22-msgbox";
			#mbox-cells = <1>;
			reg = <0x0 0x03003000 0x0 0x1000>,
			      <0x0 0x01a06000 0x0 0x1000>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_MSGBOX_CPUX_AHB>;
			clock-names = "msgbox";
			resets = <&ccu RST_BUS_MSGBOX_CPUX>;
			reset-names = "rst";
			local_id = <0>;
			status = "okay";
		};

		hwspinlock: hwspinlock@3005000 {
			compatible = "allwinner,sunxi-hwspinlock";
			reg = <0x0 0x3005000 0x0 0x1000>;
			#hwlock-cells = <1>;
			clocks = <&ccu CLK_BUS_SPINLOCK_AHB>;
			clock-names = "clk_hwspinlock_bus";
			resets = <&ccu RST_BUS_SPINLOCK>;
			reset-names = "rst";
			num-locks = <32>;
			status = "okay";
		};

		gpadc0: gpadc@2087000 {
			compatible = "allwinner,sunxi-gpadc-v102";
			reg = <0x0 0x02087000 0x0 0x400>;
			interrupts = <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_GPADC0_APB>, <&ccu CLK_GPADC0>;
			clock-names = "bus", "hosc";
			resets = <&ccu RST_BUS_GPADC0>;
			status = "disabled";
		};

		gpadc1: gpadc@2088000 {
			compatible = "allwinner,sunxi-gpadc-v101";
			reg = <0x0 0x02088000 0x0 0x400>;
			interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_GPADC1_APB>, <&ccu CLK_GPADC1>;
			clock-names = "bus", "hosc";
			resets = <&ccu RST_BUS_GPADC1>;
			status = "disabled";
		};

		gpadc2: gpadc@2089000 {
			compatible = "allwinner,sunxi-gpadc-v103";
			reg = <0x0 0x02089000 0x0 0x400>,
				<0x0 0x0208c000 0x0 0x400>; /* rtp base reg */
			interrupts = <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_GPADC2_APB>, <&ccu CLK_GPADC2>, <&ccu CLK_TPADC>, <&ccu CLK_BUS_TPADC_APB>;
			clock-names = "bus", "hosc", "rtp_mod", "rtp_bus";
			resets = <&ccu RST_BUS_GPADC2>, <&ccu RST_BUS_TPADC>;
			reset-names = "rst", "rtp_rst";
			status = "disabled";
		};

		gpadc3: gpadc@208a000 {
			compatible = "allwinner,sunxi-gpadc-v101";
			reg = <0x0 0x0208a000 0x0 0x400>;
			interrupts = <GIC_SPI 106 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_GPADC3_APB>, <&ccu CLK_GPADC3>;
			clock-names = "bus", "hosc";
			resets = <&ccu RST_BUS_GPADC3>;
			status = "disabled";
		};

		irrx0: irrx@2081000 {
			compatible = "allwinner,irrx";
			reg = <0x0 0x02081000 0x0 0x400>;
			interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_IR_RX0_APB>, <&dcxo24M>, <&ccu CLK_IR_RX0>;
			clock-names = "bus", "pclk", "mclk";
			resets = <&ccu RST_BUS_IR_RX0>;
			status = "disabled";
		};

		irrx1: irrx@2082000 {
			compatible = "allwinner,irrx";
			reg = <0x0 0x02082000 0x0 0x400>;
			interrupts = <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_IR_RX1_APB>, <&dcxo24M>, <&ccu CLK_IR_RX1>;
			clock-names = "bus", "pclk", "mclk";
			resets = <&ccu RST_BUS_IR_RX1>;
			status = "disabled";
		};

		irrx2: irrx@2083000 {
			compatible = "allwinner,irrx";
			reg = <0x0 0x02083000 0x0 0x400>;
			interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_IR_RX2_APB>, <&dcxo24M>, <&ccu CLK_IR_RX2>;
			clock-names = "bus", "pclk", "mclk";
			resets = <&ccu RST_BUS_IR_RX2>;
			status = "disabled";
		};

		irrx3: irrx@2084000 {
			compatible = "allwinner,irrx";
			reg = <0x0 0x02084000 0x0 0x400>;
			interrupts = <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_IR_RX3_APB>, <&dcxo24M>, <&ccu CLK_IR_RX3>;
			clock-names = "bus", "pclk", "mclk";
			resets = <&ccu RST_BUS_IR_RX3>;
			status = "disabled";
		};

		irtx0: irtx@2080000 {
			compatible = "allwinner,irtx";
			reg = <0x0 0x02080000 0x0 0x400>;
			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_IR_TX_APB>, <&dcxo24M>, <&ccu CLK_IR_TX>;
			clock-names = "bus", "pclk", "mclk";
			resets = <&ccu RST_BUS_IR_TX>;
			status = "disabled";
		};

		rfkill: rfkill {
			compatible = "allwinner,sunxi-rfkill";
			status = "disabled";
		};

		addr_mgt: addr_mgt {
			compatible = "allwinner,sunxi-addr_mgt";
			status = "disabled";
		};

		btlpm: btlpm {
			compatible = "allwinner,sunxi-btlpm";
			status = "disabled";
		};

		g2d: g2d@5440000 {
			status = "okay";
			compatible = "allwinner,sunxi-g2d";
			reg = <0x0 0x05440000 0x0 0x30000>;
			/* interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 150 IRQ_TYPE_LEVEL_HIGH>;
				<GIC_SPI 151 IRQ_TYPE_LEVEL_HIGH>;
				<GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>; */
			interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_G2D_AHB>, <&ccu CLK_G2D>,
				<&ccu CLK_MBUS_BUS_VIDEO_OUT0_SW_CFG>,
				<&ccu CLK_BUS_VIDEO_OUT0_AHB_SW_CFG>;
			clock-names = "bus", "g2d", "mbus_vo", "vo";
			resets = <&ccu RST_BUS_G2D>, <&ccu RST_BUS_VIDEO_OUT0>;
			reset-names = "rst_bus_g2d", "vo_reset";
			assigned-clocks = <&ccu CLK_G2D>;
			assigned-clock-rates = <300000000>;
			thread-id = <0>;
		};

		/* audio dirver module -> audio codec */
		codec:codec@2030000 {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-codec";
			reg		= <0x0 0x02030000 0x0 0x320>;
			resets		= <&ccu RST_BUS_AUDIOCODEC0>;
			clocks		= <&ccu CLK_BUS_AUDIOCODEC0_APB>,
					  <&ccu CLK_AUDIOCODEC0_DAC>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_PERI1_600M>;
			clock-names	= "clk_bus_audio0_apb",
					  "clk_audiocodec0_dac",
					  "clk_pll_audio0",
					  "clk_pll_peri1_600m";
			status = "disabled";
		};

		codec_plat:codec_plat {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-plat-aaudio";
			dac-txdata	= <0x02030020>;
			dmas		= <&dma 7>, <&dma 7>;
			dma-names	= "tx";
			playback-cma	= <128>;
			tx-fifo-size	= <128>;
			status = "disabled";
		};

		codec_mach:codec_mach {
			compatible	= "allwinner,sunxi-snd-mach";
			soundcard-mach,name = "audiocodec";
			soundcard-mach,pin-switches = "LINEOUTL", "SPK";
			soundcard-mach,routing = "LINEOUTL", "LINEOUTLP_PIN",
						 "LINEOUTL", "LINEOUTLN_PIN",
						 "SPK", "LINEOUTLP_PIN",
						 "SPK", "LINEOUTLN_PIN";
			soundcard-mach,playback-only;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&codec_plat>;
			};
			soundcard-mach,codec {
				/* pll freq = 24.576M or 22.5792M * pll-fs */
				soundcard-mach,pll-fs = <1>;
				sound-dai = <&codec>;
			};
		};

		/* audio dirver module -> dmic */
		dmic_plat:dmic_plat@2031000 {
			#sound-dai-cells = <0>;
			compatible	= "allwinner,sunxi-snd-plat-dmic";
			reg		= <0x0 0x02031000 0x0 0x50>;
			resets		= <&ccu RST_BUS_DMIC>;
			clocks		= <&ccu CLK_BUS_DMIC_APB>,
					  <&ccu CLK_DMIC>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_PERI1_600M>;
			clock-names	= "clk_bus_dmic",
					  "clk_dmic",
					  "clk_pll_audio0",
					  "clk_pll_peri1_600m";
			dmas		= <&dma 8>, <&dma 8>;
			dma-names	= "rx";
			capture-cma	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		dmic_mach:dmic_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "snddmic";
			soundcard-mach,capture-only;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&dmic_plat>;
			};
			soundcard-mach,codec {
			};
		};

		/* audio dirver module -> I2S/PCM */
		i2s0_plat:i2s0_plat@2032000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sunxi-snd-plat-i2s";
			reg		= <0x0 0x02032000 0x0 0x7C>;
			resets		= <&ccu RST_BUS_I2S0>;
			clocks		= <&ccu CLK_BUS_I2S0_APB>,
					  <&ccu CLK_I2S0>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_PERI1_600M>;
			clock-names	= "clk_bus_i2s",
					  "clk_i2s",
					  "clk_pll_audio0",
					  "clk_pll_peri1_600m";
			dmas		= <&dma 3>, <&dma 3>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		i2s0_mach:i2s0_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "sndi2s0";
			soundcard-mach,format		= "i2s";
			soundcard-mach,slot-num		= <2>;
			soundcard-mach,slot-width	= <32>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&i2s0_plat>;
			};
			soundcard-mach,codec {
			};
		};

		i2s1_plat:i2s1_plat@2033000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sunxi-snd-plat-i2s";
			reg		= <0x0 0x02033000 0x0 0x7C>;
			resets		= <&ccu RST_BUS_I2S1>;
			clocks		= <&ccu CLK_BUS_I2S1_APB>,
					  <&ccu CLK_I2S1>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_PERI1_600M>;
			clock-names	= "clk_bus_i2s",
					  "clk_i2s",
					  "clk_pll_audio0",
					  "clk_pll_peri1_600m";
			dmas		= <&dma 4>, <&dma 4>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		i2s1_mach:i2s1_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "sndi2s1";
			soundcard-mach,format		= "i2s";
			soundcard-mach,slot-num		= <2>;
			soundcard-mach,slot-width	= <32>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&i2s1_plat>;
			};
			soundcard-mach,codec {
			};
		};

		i2s2_plat:i2s2_plat@2034000 {
			#sound-dai-cells = <0>;
			compatible = "allwinner,sunxi-snd-plat-i2s";
			reg		= <0x0 0x02034000 0x0 0x7C>;
			resets		= <&ccu RST_BUS_I2S2>;
			clocks		= <&ccu CLK_BUS_I2S2_APB>,
					  <&ccu CLK_I2S2>,
					  <&ccu CLK_PLL_AUDIO0>,
					  <&ccu CLK_PLL_PERI1_600M>;
			clock-names	= "clk_bus_i2s",
					  "clk_i2s",
					  "clk_pll_audio0",
					  "clk_pll_peri1_600m";
			dmas		= <&dma 5>, <&dma 5>;
			dma-names	= "tx", "rx";
			playback-cma	= <128>;
			capture-cma	= <128>;
			tx-fifo-size	= <128>;
			rx-fifo-size	= <128>;
			status = "disabled";
		};

		i2s2_mach:i2s2_mach{
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name		= "sndi2s2";
			soundcard-mach,format		= "i2s";
			soundcard-mach,slot-num		= <2>;
			soundcard-mach,slot-width	= <32>;
			status = "disabled";
			soundcard-mach,cpu {
				sound-dai = <&i2s2_plat>;
			};
			soundcard-mach,codec {
			};
		};

	};
};



