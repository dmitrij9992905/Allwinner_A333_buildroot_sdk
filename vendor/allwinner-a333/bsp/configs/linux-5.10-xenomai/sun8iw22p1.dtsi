			compatible = "allwinner,uart-v101";
			reg = <0x0 0x02607000 0x0 0x400>;
			interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_UART7_APB>;
			resets = <&ccu RST_BUS_UART7>;
			uart7_port = <7>;
			uart7_type = <4>;
			sunxi,uart-fifosize = <64>;
			dmas = <&dma 21>, <&dma 21>;
			dma-names = "fake_tx", "fake_rx";
			//dma-names = "tx", "rx";
