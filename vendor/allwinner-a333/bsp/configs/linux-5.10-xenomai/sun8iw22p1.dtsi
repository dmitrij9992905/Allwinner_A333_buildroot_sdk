		uart8: uart@2608000 {
			compatible = "allwinner,uart-v101";
			reg = <0x0 0x02608000 0x0 0x400>;
			interrupts = <GIC_SPI 148 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&ccu CLK_BUS_UART8_APB>;
			resets = <&ccu RST_BUS_UART8>;
			uart8_port = <8>;
			uart8_type = <8>;
			sunxi,uart-fifosize = <64>;
